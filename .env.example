# Database (connects to ie-api-db container)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=music
DB_USER=platform
DB_PASSWORD=12345678
# Root credentials are only used once on startup to CREATE the music DB and GRANT access
DB_ROOT_USER=root
DB_ROOT_PASSWORD=87654321

# Spotify — create an app at https://developer.spotify.com/dashboard
# Set the redirect URI there to: http://localhost:8002/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8002/auth/spotify/callback

# YouTube Music — path to your ytmusic_auth.json (generated by `ytmusicapi setup`)
YTMUSIC_AUTH_FILE=/app/ytmusic_auth.json

# Local music folder (must be an absolute path accessible to the container)
MUSIC_LOCAL_PATH=/Users/roquendo/Music/local

# App
CORS_ORIGINS=http://localhost:3002,http://localhost:5173
SECRET_KEY=change-me-in-production
